{
  "expo": {
    "name": "SkinSnap",
    "slug": "skinsnap",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "skinsnap",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alphatekx.skinsnap",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#08090D"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08090D",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#08090D"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkinSnap to choose a photo for your skincare preview.",
          "cameraPermission": "Allow SkinSnap to take a skincare photo.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
