{
  "expo": {
    "name": "SkinSnap",
    "slug": "skinsnap",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "skinsnap",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "translucent": true
    },
    "android": {
      "package": "com.skinsnap.app",
      "versionCode": 6,
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#08090D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08090D",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#08090D"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SkinSnap to choose a photo for your skincare preview.",
          "cameraPermission": "Allow SkinSnap to take a skincare photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "extraProguardRules": "-keep class com.facebook.hermes.** { *; }\n-keep class com.swmansion.reanimated.** { *; }"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "3671a7f1-1871-4151-9761-7ed212444bb5"
      }
    },
    "owner": "alphatekx"
  }
}
