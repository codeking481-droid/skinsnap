{
  "name": "skinsnap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-purchases": "^10.15.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "typecheck:mobile": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc --keep-vars true"
  },
  "private": true,
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
